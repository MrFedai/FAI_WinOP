{
  "$schema": "./_schema.json",
  "name": "fedai",
  "description": "Format sonrası kişisel kurulum (docs/ROADMAP.md 3): koyu / siyah arayüz, sade görev çubuğu, bloatware ve Edge yok, gizlilik, ses %15, dizüstü güç planı. Güncellemeler en sonda: hepsi kurulur, sonra 365 gün duraklatılır.",
  "tweaks": [
    "system.restore-point",
    "setup.mmagent-off",
    "setup.background-apps-off",
    "setup.store-optimize",
    "setup.default-browser",
    "graphics.nvidia-settings",
    "graphics.amd-settings",
    "graphics.p0-state",
    "ui.theme-black",
    "ui.lockscreen-black",
    "ui.account-pictures-black",
    "ui.taskbar",
    "ui.desktop-icons",
    "ui.widgets-off",
    "ui.copilot-off",
    "ui.notepad-settings",
    "ui.explorer",
    "ui.visual-effects",
    "ui.notifications",
    "bloat.remove",
    "bloat.persistence",
    "bloat.edge-remove",
    "sound.startup-sound-off",
    { "id": "sound.volume", "params": { "level": 15 } },
    "privacy.telemetry",
    "privacy.app-permissions",
    "privacy.search-ads",
    "power.plan",
    "system.timer-resolution",
    { "id": "setup.updates-staged", "params": { "pauseDays": 365 } }
  ],
  "autoConfirm": [],
  "apps": [
    "claude",
    { "id": "telegram", "keepAutostart": true },
    { "id": "whatsapp", "keepAutostart": true },
    "discord",
    "steam",
    "tradingview",
    "ollama",
    "vscode",
    "protonvpn",
    "chrome",
    "spotify",
    "obs"
  ],
  "games": [],
  "layout": {},
  "exceptions": {}
}
