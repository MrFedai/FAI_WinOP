{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/MrFedai/FAI_WinOP/profiles/_schema.json",
  "title": "FAI_WinOP profili",
  "description": "BELGE / editör desteği. Asıl doğrulama src/Core/Schema.ps1 (Get-FaiProfileError) içindedir; Windows PowerShell 5.1'de Test-Json yoktur. İzin verilen alan adları ikisinde birebir aynı tutulur (tests/Unit/Schema.Tests.ps1 denetler).",
  "type": "object",
  "additionalProperties": false,
  "required": [ "name", "tweaks" ],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Profil adı: küçük harf, rakam, tire."
    },
    "description": { "type": "string" },
    "tweaks": {
      "type": "array",
      "description": "Uygulanacak tweak'ler, bu sırayla. Tekrar eden kimlik hatadır.",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/tweakId" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [ "id" ],
            "properties": {
              "id": { "$ref": "#/definitions/tweakId" },
              "params": {
                "type": "object",
                "description": "Tweak'in Params varsayılanlarını geçersiz kılar (tweak'te tanımlı olmayan ad hatadır)."
              }
            }
          }
        ]
      }
    },
    "autoConfirm": {
      "type": "array",
      "description": "-Unattended modda onaysız uygulanacak Caution tweak'ler (tweaks listesinde olmalı). Risk düzeyi hiçbir zaman otomatik onaylanmaz.",
      "items": { "$ref": "#/definitions/tweakId" }
    },
    "apps": {
      "type": "array",
      "description": "Kurulacak uygulamalar (apps/catalog.json kimlikleri), tweak'lerden önce, bu sırayla. Tekrar eden kimlik hatadır.",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/appId" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [ "id" ],
            "properties": {
              "id": { "$ref": "#/definitions/appId" },
              "keepAutostart": { "type": "boolean", "description": "Katalogdaki otomatik başlatma kapatma kuralını uygulama (ör. WhatsApp, Telegram)." }
            }
          }
        ]
      }
    },
    "games": {
      "type": "array",
      "description": "Faz 7 (gaming.per-game): oyun başına öncelik (IFEO CpuPriorityClass) ve işlemci benzeşimi (açılış görevi). Maskeler makinenin mantıksal işlemci / çekirdek sayısından hesaplanır. Tweak'lerden sonra, layout'tan önce uygulanır.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "exe" ],
        "properties": {
          "exe": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._ \\-]*\\.[Ee][Xx][Ee]$", "description": "Yalnız dosya adı (ör. cs2.exe), yol değil." },
          "priority": { "type": "string", "enum": [ "Idle", "BelowNormal", "Normal", "AboveNormal", "High" ] },
          "smtOff": { "type": "boolean", "description": "Her fiziksel çekirdeğin yalnız ilk mantıksal işlemcisi." },
          "excludeCore0": { "type": "boolean", "description": "Çekirdek 0'ın mantıksal işlemcileri kullanılmaz." }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "description": "Faz 6: görev çubuğu / masaüstü / Başlat düzeni (-ExportLayout yazar). 'layout.profile' tweak'i olarak tweak'lerden sonra uygulanır, -Undo geri alır. Her alan isteğe bağlı.",
      "properties": {
        "taskbar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alignment": { "type": "string", "enum": [ "center", "left" ] },
            "autoHide": { "type": "boolean", "description": "StuckRects3 Settings 8. bayt, 0. bit." },
            "pins": {
              "type": "array",
              "description": "Sabitlemeler sırayla; listede olmayanlar kalkar.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "maxProperties": 1,
                "properties": {
                  "appId": { "type": "string", "enum": [ "Microsoft.Windows.Explorer" ], "description": "Bilinen masaüstü uygulama kimliği (Dosya Gezgini)." },
                  "link": { "type": "string", "pattern": "\\.lnk$", "description": "Başlat menüsündeki kısayolun yolu, ortam değişkenli (%ProgramData%\\...)." },
                  "aumid": { "type": "string", "description": "Store uygulamasının AppUserModelID'si (<paket ailesi>!<uygulama>)." }
                }
              }
            }
          }
        },
        "desktopIcons": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "thisPC": { "type": "boolean" },
            "recycleBin": { "type": "boolean" },
            "userFiles": { "type": "boolean" },
            "network": { "type": "boolean" },
            "controlPanel": { "type": "boolean" }
          }
        },
        "desktop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flags": { "type": "integer", "description": "Bags\\1\\Desktop FFlags (1 = otomatik düzenle, 4 = kılavuza hizala)." },
            "iconSize": { "type": "integer" },
            "iconLayouts": { "type": "string", "description": "Simge konumları (IconLayouts, base64). Masaüstü öğe adlarını içerir." }
          }
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start2": { "type": "string", "description": "Başlat sabitlemeleri (start2.bin, base64)." }
          }
        }
      }
    }
  },
  "definitions": {
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "apps/catalog.json'daki uygulama kimliği, ör. chrome"
    },
    "tweakId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kategori.ad biçiminde tweak kimliği, ör. sound.startup-sound-off"
    }
  }
}
